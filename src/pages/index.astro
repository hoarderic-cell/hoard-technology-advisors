---
import Layout from '../layouts/Layout.astro';

const linkedInUrl = 'https://www.linkedin.com/in/erichoard/';

const highlights = [
	{
		title: 'Silicon Hoard',
		description:
			'My blog on technology leadership, vendor dynamics, and infrastructure decisions for organizations outside the enterprise world.',
		href: '/blog',
		label: 'Read the blog',
	},
	{
		title: 'Consulting',
		description:
			'Technology strategy, vendor negotiations, and infrastructure counsel for small and mid-sized organizations through Hoard Technology Advisors LLC.',
		href: '/consulting',
		label: 'View services',
	},
	{
		title: 'About',
		description:
			'Thirteen years from Data Center Operator to infrastructure leadership—and the story of how I got here.',
		href: '/about',
		label: 'My background',
	},
];
---

<Layout>
	<section class="hero">
		<div class="container hero__inner">
			<p class="section-label">Eric Hoard</p>
			<h1>Technology leadership, writing, and counsel.</h1>
			<div class="accent-line"></div>
			<p class="hero__lead">
				I lead infrastructure teams by day and write about the decisions that matter by night.
				Thirteen years from the data center floor to the leadership table taught me that the
				hardest technology problems usually aren't technical at all.
			</p>
			<p class="hero__role">
				IT Infrastructure Manager, Farm Bureau Insurance of Michigan
			</p>
			<div class="hero__actions">
				<a href="/blog" class="btn btn--primary">Silicon Hoard</a>
				<a href={linkedInUrl} class="btn btn--outline" target="_blank" rel="noopener noreferrer">
					LinkedIn
				</a>
			</div>
		</div>
	</section>

	<section class="section section--muted">
		<div class="container">
			<p class="section-label">Explore</p>
			<h2>What you'll find here</h2>
			<div class="accent-line"></div>

			<div class="highlights-grid">
				{
					highlights.map((item) => (
						<article class="highlight-card">
							<h3>{item.title}</h3>
							<p>{item.description}</p>
							<a href={item.href} class="highlight-card__link">
								{item.label}
								<span aria-hidden="true">→</span>
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section about-preview">
		<div class="container about-preview__inner">
			<div>
				<p class="section-label">Background</p>
				<h2>Built from the ground up</h2>
				<div class="accent-line"></div>
				<p>
					I started as a Data Center Operator because I wanted to understand how things actually
					worked. Today I lead teams across Systems Engineering, Network Engineering, Database
					Administration, Unified Communications, and M365—and I still believe the best technology
					leaders understand the work at every level.
				</p>
			</div>
			<a href="/about" class="btn btn--outline">Read my story</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-block: clamp(5rem, 12vw, 8rem);
		background: var(--color-white);
	}

	.hero__inner {
		max-width: 42rem;
	}

	.hero__lead {
		margin-top: 1.5rem;
		font-size: 1.1875rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.hero__role {
		margin-top: 1.25rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-navy);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
		margin-top: 2.5rem;
	}

	.highlight-card {
		padding: 2rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-burgundy);
	}

	.highlight-card h3 {
		margin-bottom: 0.75rem;
	}

	.highlight-card p {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin-bottom: 1.25rem;
	}

	.highlight-card__link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-burgundy);
		text-decoration: none;
	}

	.highlight-card__link:hover {
		color: var(--color-burgundy-dark);
	}

	.about-preview__inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.about-preview__inner > div {
		max-width: 40rem;
	}

	.about-preview p {
		margin-top: 1.25rem;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	@media (max-width: 768px) {
		.about-preview__inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
