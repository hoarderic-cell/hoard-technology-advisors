---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Technology Strategy',
		description:
			'Define roadmaps, set priorities, and align IT investments with business outcomes—without the overhead of advice built for companies ten times your size.',
	},
	{
		title: 'Vendor Negotiations',
		description:
			'Level the playing field with enterprise vendors. Protect your budget and interests in conversations where the leverage typically isn\'t on your side.',
	},
	{
		title: 'Infrastructure Decision-Making',
		description:
			'Navigate platform, architecture, and modernization choices with clarity. Guidance grounded in how infrastructure organizations actually operate.',
	},
	{
		title: 'Advisory & Leadership Counsel',
		description:
			'Senior perspective for technology leaders facing decisions that aren\'t really technical decisions—vendor relationships, team structure, and high-stakes tradeoffs.',
	},
];

const principles = [
	{
		title: 'Built for Your Scale',
		description:
			'Counsel designed for small and mid-sized organizations—not repurposed enterprise playbooks that assume resources you don\'t have.',
	},
	{
		title: 'Vendor Advocacy',
		description:
			'The hardest technology decisions often happen across the table from a vendor who knows you need them more than they need you. We help you hold your ground.',
	},
	{
		title: 'Ground-Up Experience',
		description:
			'Thirteen years from Data Center Operator to infrastructure leadership—across every role an organization like yours depends on.',
	},
];
---

<Layout>
	<section class="hero">
		<div class="container hero__inner">
			<p class="section-label">Senior Technology Consulting</p>
			<h1>Strategic technology leadership for small and mid-sized organizations.</h1>
			<div class="accent-line"></div>
			<p class="hero__lead">
				Hoard Technology Advisors partners with technology leaders who are tired of being
				outmaneuvered by enterprise vendors and overwhelmed by guidance built for a different
				scale—with the rigor and directness your organization deserves.
			</p>
			<div class="hero__actions">
				<a href="#contact" class="btn btn--primary">Schedule a Consultation</a>
				<a href="#services" class="btn btn--outline">Our Services</a>
			</div>
		</div>
	</section>

	<section class="section section--muted" id="services">
		<div class="container">
			<p class="section-label">What We Do</p>
			<h2>Focused expertise for technology leaders outside the enterprise world</h2>
			<div class="accent-line"></div>

			<div class="services-grid">
				{
					services.map((service) => (
						<article class="service-card">
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" id="approach">
		<div class="container approach">
			<div class="approach__content">
				<p class="section-label">Our Approach</p>
				<h2>Trusted counsel, not generic playbooks</h2>
				<div class="accent-line"></div>
				<p class="approach__text">
					The technology decisions that matter most often aren't technical at all. They're the ones
					where you're protecting your organization's budget and interests without the leverage
					larger companies take for granted. We bring clear, confidential counsel grounded in
					real infrastructure leadership—not theory.
				</p>
			</div>

			<ul class="principles-list">
				{
					principles.map((item) => (
						<li class="principle">
							<span class="principle__marker" aria-hidden="true"></span>
							<div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="cta">
		<div class="container cta__inner">
			<h2>Ready to move forward with confidence?</h2>
			<p>
				If you lead technology at a small or mid-sized organization, I'd genuinely enjoy
				connecting.
			</p>
			<a href="#contact" class="btn btn--primary">Start a Conversation</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-block: clamp(5rem, 12vw, 8rem);
		background: var(--color-white);
	}

	.hero__inner {
		max-width: 42rem;
	}

	.hero__lead {
		margin-top: 1.5rem;
		font-size: 1.1875rem;
		line-height: 1.7;
		color: var(--color-text-muted);
		max-width: 36rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1.5rem;
		margin-top: 2.5rem;
	}

	.service-card {
		padding: 2rem;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-burgundy);
	}

	.service-card h3 {
		margin-bottom: 0.75rem;
	}

	.service-card p {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.approach {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: start;
	}

	.approach__text {
		margin-top: 1.25rem;
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		line-height: 1.7;
	}

	.principles-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.principle {
		display: flex;
		gap: 1.25rem;
	}

	.principle__marker {
		flex-shrink: 0;
		width: 2px;
		background: var(--color-burgundy);
		align-self: stretch;
	}

	.principle h3 {
		margin-bottom: 0.375rem;
		font-size: 1.0625rem;
	}

	.principle p {
		font-size: 0.9375rem;
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.cta {
		padding-block: clamp(4rem, 8vw, 5.5rem);
		background: var(--color-navy);
	}

	.cta__inner {
		text-align: center;
		max-width: 32rem;
	}

	.cta h2 {
		color: var(--color-white);
		margin-bottom: 1rem;
	}

	.cta p {
		color: rgba(255, 255, 255, 0.75);
		margin-bottom: 2rem;
		font-size: 1.0625rem;
	}

	@media (max-width: 768px) {
		.approach {
			grid-template-columns: 1fr;
		}
	}
</style>
