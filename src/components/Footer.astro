---
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
	<div class="container footer__inner">
		<div class="footer__brand">
			<p class="footer__name">Eric Hoard</p>
			<p class="footer__tagline">
				Technology leadership, writing, and counsel for organizations outside the enterprise
				world.
			</p>
		</div>

		<div class="footer__links">
			<div class="footer__block">
				<p class="footer__label">Connect</p>
				<a href="mailto:hoarderic@gmail.com" class="footer__link">hoarderic@gmail.com</a>
				<a
					href="https://www.linkedin.com/in/erichoard/"
					class="footer__link"
					target="_blank"
					rel="noopener noreferrer">LinkedIn</a
				>
			</div>
			<div class="footer__block">
				<p class="footer__label">More</p>
				<a href="/blog" class="footer__link">Silicon Hoard</a>
				<a href="/consulting" class="footer__link">Consulting</a>
			</div>
		</div>
	</div>

	<div class="container footer__bottom">
		<p>&copy; {year} Eric Hoard. All rights reserved.</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-navy);
		color: rgba(255, 255, 255, 0.8);
		padding-top: 3.5rem;
	}

	.footer__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer__name {
		margin: 0 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-white);
	}

	.footer__tagline {
		margin: 0;
		font-size: 0.9375rem;
		max-width: 28rem;
		line-height: 1.6;
	}

	.footer__links {
		display: flex;
		gap: 3rem;
	}

	.footer__block {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer__label {
		margin: 0 0 0.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-burgundy);
	}

	.footer__link {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-white);
		text-decoration: none;
	}

	.footer__link:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	.footer__bottom {
		padding-block: 1.5rem;
	}

	.footer__bottom p {
		margin: 0;
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.5);
	}

	@media (max-width: 640px) {
		.footer__inner {
			grid-template-columns: 1fr;
		}

		.footer__links {
			gap: 2rem;
		}
	}
</style>
